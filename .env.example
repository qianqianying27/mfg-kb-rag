# ===== 大模型（OpenAI 兼容，三选一，改这里就切换）=====
# 1) 本地 vLLM（默认，数据不出厂）：http://127.0.0.1:8000/v1
# 2) DeepSeek：https://api.deepseek.com/v1   model=deepseek-chat
# 3) 阿里百炼：https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL=qwen-scorer
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ===== Embedding =====
# bge 查询侧会自动加指令前缀；用本机已装的 CUDA 版 torch 跑在 GPU 上
# CUDA 不可用或显存不足时会自动回退 CPU（日志会告警），不会启动失败
# 没有显卡的机器填 EMBEDDING_DEVICE=cpu 即可
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# ===== 分块策略 =====
CHUNK_SIZE=480
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=40

# ===== 检索 =====
TOP_K=5
VECTOR_TOP_K=8
BM25_TOP_K=8
RRF_K=60
MIN_SIMILARITY=0.40
ENABLE_HYBRID=true
ENABLE_REWRITE=true

# ===== 存储 =====
COLLECTION_NAME=mfg_docs

# ===== 重排序 =====
# 开启后召回结果用 bge-reranker 精排取 Top-3，上下文更短更干净；CPU 上实测 +530ms
# 注意：模型不进 requirements，需先从 HF 缓存下载（见 README 6.8），缺失会自动退回原顺序
ENABLE_RERANK=false
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_DEVICE=cpu
RERANK_TOP_N=3
